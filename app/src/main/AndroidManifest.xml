<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AhorraYa">

        <!-- Ventana 1: presentación (actividad de inicio) -->
        <activity
            android:name=".PresentacionActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Ventana 2: formulario de inscripción -->
        <activity
            android:name=".FormularioActivity"
            android:exported="false" />

        <!-- Ventana 3: aceptación de la inscripción -->
        <activity
            android:name=".AceptacionActivity"
            android:exported="false" />
    </application>

</manifest>
