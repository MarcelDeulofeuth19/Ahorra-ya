<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#F4FAF6"
    android:fitsSystemWindows="true"
    android:padding="24dp">

    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:src="@drawable/ic_logo"
        android:contentDescription="Logo de AhorraYa" />

    <TextView
        android:id="@+id/tvNombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="AhorraYa"
        android:textColor="#1B8A5A"
        android:textSize="36sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvLema"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Aprende a manejar tu dinero"
        android:textColor="#333333"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tvDescripcion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="Inscríbete al programa gratuito de educación financiera de 4 semanas: ahorro, crédito responsable e inversión, desde tu celular."
        android:textColor="#555555"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnComenzar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Comenzar inscripción"
        android:textSize="16sp" />

</LinearLayout>
